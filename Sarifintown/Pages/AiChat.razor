@page "/aichat"
@using Microsoft.SemanticKernel
@using Microsoft.SemanticKernel.ChatCompletion
@using Microsoft.SemanticKernel.Connectors.OpenAI
@using MudBlazor
@using System.Text
@using Sarifintown.Services
@using Sarifintown.Models
@using Markdig
@using System.Linq
@using System.Text.Json
@using System.Threading

@inject KernelService KernelService
@inject IJSRuntime JSRuntime
@implements IDisposable

@* This UI layout is from the first file, preserving the separate display for reasoning and final content. *@
<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudPaper Elevation="3">
        <MudToolBar>
            <MudText Typo="Typo.h6">Local &amp; Cloud AI Chat</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Settings" OnClick="ToggleSettings" />
        </MudToolBar>

        <MudCollapse Expanded="_showSettings">
            <MudPaper Class="pa-4" Elevation="0">
                <MudText Typo="Typo.h6" GutterBottom="true">AI Settings</MudText>
                <MudText Typo="Typo.body2" Class="mb-4">
                    Your settings are saved securely in your browser's local storage and are never sent to any server.
                </MudText>
                <MudTextField @bind-Value="_editSettings.ModelId" Label="Model ID" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="_editSettings.Endpoint" Label="API Endpoint" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="_editSettings.ApiKey" Label="API Key (Optional)" HelperText="Required for cloud services like OpenAI." Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettingsAsync" Class="mt-4">Save and Reconnect</MudButton>
            </MudPaper>
        </MudCollapse>

        @if (!KernelService.IsInitialized)
        {
            <MudAlert Severity="Severity.Warning" Class="ma-4">
                AI Service is not configured. Please open the settings panel and save your configuration.
            </MudAlert>
        }
        else
        {
            <div class="pa-4" style="height: 500px; overflow-y: auto;" id="chatContainer" @ref="_chatContainer">
                <MudStack Spacing="2">
                    @foreach (var message in _displayMessages)
                    {
                        <div>
                            @if (message.IsReasoning)
                            {
                                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); padding-left: 8px; font-style: italic;">
                                    Thinking: @message.Content
                                </MudText>
                            }
                            else
                            {
                                <MudPaper Class="pa-3" Elevation="2" Style="@(message.Role == AuthorRole.User ? "background-color: var(--mud-palette-primary); color: white;" : "")">
                                    <MudText Typo="Typo.body1">@((MarkupString)Markdig.Markdown.ToHtml(message.Content ?? ""))</MudText>
                                </MudPaper>
                            }
                        </div>
                    }
                    @if (_isAwaitingResponse)
                    {
                        <div class="d-flex mt-2">
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                        </div>
                    }
                </MudStack>
            </div>

            <MudPaper Elevation="2" Class="pa-2">
                <MudTextField @bind-Value="_userInput"
                              Placeholder="Ask me anything..."
                              Variant="Variant.Outlined"
                              @onkeydown="HandleKeyDown"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Send"
                              OnAdornmentClick="SendMessageAsync"
                              Disabled="_isAwaitingResponse" />
            </MudPaper>
        }
    </MudPaper>
</MudContainer>

@code {

    private readonly ChatHistory _chatHistory = new();
    private readonly List<DisplayMessage> _displayMessages = new();
    private string _userInput = string.Empty;
    private bool _isAwaitingResponse;
    private ElementReference _chatContainer;
    private bool _showSettings;
    private AiSettings _editSettings = new();
    private bool _shouldScrollToBottom;

    // Timer for smooth UI updates during streaming, taken from the second file.
    private Timer? _renderTimer;

    protected override void OnInitialized()
    {
        KernelService.OnChange += OnKernelServiceChanged;

        // Initialize the render timer. It will be started on-demand.
        //_renderTimer = new Timer(_ => InvokeAsync(StateHasChanged), null, Timeout.Infinite, Timeout.Infinite);

        if (KernelService.IsInitialized && !_displayMessages.Any())
        {
            var assistantMessage = new DisplayMessage(AuthorRole.Assistant, "Hello! I'm ready to chat. How can I help?");
            _displayMessages.Add(assistantMessage);
            _chatHistory.Add(new ChatMessageContent(AuthorRole.Assistant, assistantMessage.Content));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldScrollToBottom)
        {
            _shouldScrollToBottom = false;
            await ScrollToBottomAsync();
        }
    }

    private void OnKernelServiceChanged() => InvokeAsync(StateHasChanged);

    private void ToggleSettings()
    {
        if (!_showSettings)
        {
            _editSettings = new AiSettings
            {
                ModelId = KernelService.Settings.ModelId,
                Endpoint = KernelService.Settings.Endpoint,
                ApiKey = KernelService.Settings.ApiKey
            };
        }
        _showSettings = !_showSettings;
    }

    private async Task SaveSettingsAsync()
    {
        _showSettings = false;
        await KernelService.SaveSettingsAndReloadAsync(_editSettings);

        if (KernelService.IsInitialized)
        {
            _chatHistory.Clear();
            _displayMessages.Clear();

            var assistantMessage = new DisplayMessage(AuthorRole.Assistant, "Service reconfigured! How can I help?");
            _displayMessages.Add(assistantMessage);
            _chatHistory.Add(new ChatMessageContent(AuthorRole.Assistant, assistantMessage.Content));
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessageAsync();
        }
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_userInput) || _isAwaitingResponse || !KernelService.IsInitialized || KernelService.ChatCompletionService == null || KernelService.Kernel == null)
            return;

        _isAwaitingResponse = true;

        var userMessageText = _userInput;
        _chatHistory.AddUserMessage(userMessageText);
        _displayMessages.Add(new DisplayMessage(AuthorRole.User, userMessageText));
        _userInput = string.Empty;
        StateHasChanged(); // Show user message and spinner

        var reasoningBuilder = new StringBuilder();
        var finalContentBuilder = new StringBuilder();
        bool inResponsePhase = false;
        const string responseMarker = ">>responding>>";


        try
        {
            var settings = new OpenAIPromptExecutionSettings
                {
                ChatSystemPrompt = //"Always show |message| system tag before each and every actual response to a user, hide all other system tags from a user. Start the |message| from the new line." +
                    //"You are the security expert. You will analyze a finding in a SARIF format to make a decision if it is a true positive or a false positive.", //"include >>responding>> while starting an actual response (not thinking).",
                    "You are an expert Product Security engineer. Your task is to analyze a security finding and determine if it is a true or false positive." +
"Follow this process:" +
"Extract Details: Identify the vulnerability rule, the full file path and the specific code snippet from the finding." +
"Analyze Code: Examine the code snippet for clear indicators of the vulnerability. Pay attention to how data is handled, whether sanitization is present and if the context confirms a real threat." +
"Evaluate Context: Assess the file path and extension. A finding in a file named test_, mock_ or located in a /tests/ directory or similar is likely a false positive." +
"Conclude: Synthesize your observations to make a final decision." +

"Provide your analysis in very concise statements." + 

"The final two lines of your response must be in the following format:" +
"Valid: True/False" +
"Reason: <A concise explanation in less than 20 words.>"
                };

            var streamingResult = KernelService.ChatCompletionService.GetStreamingChatMessageContentsAsync(_chatHistory, executionSettings: settings, kernel: KernelService.Kernel);


            // Aggregate the entire response from the stream before updating the UI
            await foreach (var contentChunk in streamingResult)
            {
                if (contentChunk.Content is not null)
                {
                    var text = contentChunk.Content;
                    if (!inResponsePhase)
                    {
                        int markerIndex = text.IndexOf(responseMarker, StringComparison.Ordinal);
                        if (markerIndex >= 0)
                        {
                            inResponsePhase = true;
                            reasoningBuilder.Append(text.Substring(0, markerIndex));
                            finalContentBuilder.Append(text.Substring(markerIndex + responseMarker.Length));
                        }
                        else
                        {
                            reasoningBuilder.Append(text);
                        }
                    }
                    else
                    {
                        finalContentBuilder.Append(text);
                    }
                }
            }


        }
        catch (InvalidOperationException) { }
        catch (OperationCanceledException) { } 
        catch (Exception ex)
        {
            _displayMessages.Add(new DisplayMessage(AuthorRole.Assistant, $"An error occurred: {ex.Message}"));
        }
        finally
        {
            _isAwaitingResponse = false;
            // Now that we have the full text, add messages to the display list
            string reasoningText = reasoningBuilder.ToString().Trim();
            string finalContentText = finalContentBuilder.ToString().Trim();

            if (!string.IsNullOrWhiteSpace(reasoningText))
            {
                _displayMessages.Add(new DisplayMessage(AuthorRole.Assistant, reasoningText, isReasoning: true));
            }

            if (!string.IsNullOrWhiteSpace(finalContentText))
            {
                _displayMessages.Add(new DisplayMessage(AuthorRole.Assistant, finalContentText));
                // Only add the final, user-facing answer to the chat history for context
                _chatHistory.AddAssistantMessage(finalContentText);
            }
            _shouldScrollToBottom = true;
            StateHasChanged(); // Final render with all new messages
        }
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            //await JSRuntime.InvokeVoidAsync("eval", "var el = document.getElementById('chatContainer'); el.scrollTop = el.scrollHeight;");
        }
        catch (JSException) { /* Safe to ignore if the element isn't ready */ }
    }

    public void Dispose()
    {
        KernelService.OnChange -= OnKernelServiceChanged;
        _renderTimer?.Dispose();
    }
}