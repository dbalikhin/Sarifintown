
@using Sarifintown.Services
@inject AppModeService AppModeService

<MudNavMenu>
    @if (AppModeService.IsMcpHosted)
    {
        <MudNavLink Href="mcp/dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard">MCP Dashboard</MudNavLink>
        <MudNavLink Href="mcp/files" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Folder">Workspace SARIF</MudNavLink>
    }
    else
    {
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.UploadFile">Import SARIF</MudNavLink>
        <MudNavLink Href="analysis" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Pageview">View Results</MudNavLink>
        @*<MudNavLink Href="testpage" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Construction">Test Page</MudNavLink>*@
        <MudNavLink Href="settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
    }
