    <MudNavGroup Title="Settings" Icon="@Icons.Material.Filled.Settings">
        <MudNavLink Href="/" Icon="@Icons.Material.Filled.Place" IconColor="Color.Info">Placeholder</MudNavLink>
    </MudNavGroup>
    *@
